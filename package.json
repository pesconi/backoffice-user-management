{
  "name": "backoffice-user-management",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "eslint .",
    "test": "pnpm --recursive run test",
